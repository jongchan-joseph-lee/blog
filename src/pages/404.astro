---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="페이지를 찾을 수 없음">
  <div class="wrap">
    <header class="page-head">
      <h1>이 주소에는 페이지가 없습니다</h1>
      <p class="sub">주소가 바뀌었거나 삭제된 페이지입니다. <a href={url()}>홈</a>이나 <a href={url('projects/')}>프로젝트</a>에서 찾아 주세요.</p>
    </header>
  </div>
</Base>
