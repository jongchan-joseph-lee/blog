---
// 기본 화면 = 프로필
// 소개 · 링크 · "지금 하고 있는 일"은 src/data/site.yaml, 본문은 src/content/pages/profile.md 에서 고칩니다.
import Base from '../layouts/Base.astro';
import Spectrogram from '../components/Spectrogram.astro';
import { getEntry, render } from 'astro:content';
import { site, url } from '../lib/site';

const page = (await getEntry('pages', 'profile'))!;
const { Content, headings } = await render(page);
const toc = headings.filter((h) => h.depth === 2);
---
<Base description={page.data.description} source="src/content/pages/profile.md">
  <Spectrogram />

  <div class="wrap profile">
    <aside class="profile-side">
      <img src={url('images/profile.jpg')} alt={`${site.name_ko} 사진`} width="240" height="240" />
      <h1>{site.name_ko}<small>{site.name_en}</small></h1>
      <p>{site.role}<br />{site.affiliation}</p>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
      </ul>
      <nav class="profile-toc" aria-label="프로필 목차">
        <a href="#focus">지금 하고 있는 일</a>
        {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        <a href={url('projects/')}>프로젝트 페이지</a>
      </nav>
    </aside>

    <div>
      <p class="lede profile-lede">{site.intro}</p>

      <section class="focus profile-focus" id="focus" aria-labelledby="focus-h">
        <h2 id="focus-h">지금 하고 있는 일</h2>
        <dl>
          {site.focus.map((f) => (<div><dt>{f.title}</dt><dd>{f.text}</dd></div>))}
        </dl>
      </section>

      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</Base>
