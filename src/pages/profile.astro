---
// 예전 주소(/profile/)로 들어오면 첫 화면(프로필)으로 보냅니다.
import { url } from '../lib/site';
const to = url();
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <title>프로필로 이동</title>
  </head>
  <body><a href={to}>프로필로 이동</a></body>
</html>
