---
// 홈 첫 화면 스펙트로그램 — Watkins Marine Mammal Sound Database 실제 녹음 6개를 이어 붙인 띠.
// 띠 이미지와 측정값은 scripts/hero/build_hero.py 가 만듭니다 (public/hero/strip.webp, src/data/hero.json).
// 세로축: 로그 주파수 20 Hz – 24 kHz, 가로축: 시간(오른쪽이 현재).
import hero from '../data/hero.json';
import { url } from '../lib/site';

const PAD = 0.14; // 위쪽 여백 비율 (주석 글자 자리)
const lg = (f: number) => Math.log(f);
const pct = (f: number) => (PAD + (1 - PAD) * (1 - (lg(f) - lg(hero.f_min)) / (lg(hero.f_max) - lg(hero.f_min)))) * 100;
const ticks = [
  { f: 100, label: '100 Hz' },
  { f: 1000, label: '1 kHz' },
  { f: 10000, label: '10 kHz' },
];
const hz = (f: number) => (f >= 1000 ? `${(f / 1000).toFixed(f >= 10000 ? 1 : 2)} kHz` : `${Math.round(f)} Hz`);
const config = { ...hero, pad: PAD, strip: url('hero/strip.webp') };
---
<div class="band" data-spectrogram role="img"
  aria-label="Watkins 해양포유류 음향 DB의 실제 녹음 여섯 개를 이어 붙인 스펙트로그램. 각 신호에 지속시간, 중앙 주파수, 최대 주파수, −3 dB 대역폭이 표시됩니다.">
  <canvas data-layer="spec"></canvas>
  <canvas data-layer="ann"></canvas>
  {ticks.map((t) => <span class="tick" style={`top:${pct(t.f).toFixed(2)}%`}>{t.label}</span>)}
  <button class="pause" type="button" data-pause aria-pressed="false">일시정지</button>
  <script type="application/json" data-hero set:html={JSON.stringify(config)} />
</div>

<div class="wrap">
  <details class="band-info">
    <summary>Watkins Marine Mammal Sound Database의 실제 녹음 6개를 이어 붙인 스펙트로그램입니다. 상자는 신호 에너지의 90% 구간이고, 수치는 직접 계산한 값입니다. <span>자료와 측정 방법</span></summary>
    <div class="band-table">
      <table>
        <thead>
          <tr>
            <th>종 (학명)</th><th>신호</th><th>Watkins 녹음</th><th>fs</th>
            <th>dur<sub>90</sub></th><th>f<sub>50</sub></th><th>f<sub>peak</sub></th><th>BW<sub>−3 dB</sub></th>
          </tr>
        </thead>
        <tbody>
          {hero.clips.map((c) => (
            <tr>
              <td>{c.name_ko} <i>{c.scientific}</i></td>
              <td>{c.signal}</td>
              <td>{c.record}<br /><span class="dim">{c.year}, {c.place}</span></td>
              <td>{hz(c.fs)}</td>
              <td>{c.duration.toFixed(2)} s</td>
              <td>{hz(c.f50)}</td>
              <td>{hz(c.fpeak)}</td>
              <td>{hz(c.bw3)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="band-method">
      <li>측정 영역 안에서 배경 잡음(주파수 bin별 전체 클립 파워의 20번째 백분위수)을 뺀 파워로 계산했습니다.</li>
      <li><b>dur<sub>90</sub></b>: 시간 누적 에너지 5–95% 구간의 길이 (Duration 90%)</li>
      <li><b>f<sub>50</sub></b>: 스펙트럼 누적 에너지가 50%가 되는 주파수 (Center / Median Frequency)</li>
      <li><b>f<sub>peak</sub></b>: 합산 스펙트럼이 최대인 주파수 (Peak Frequency)</li>
      <li><b>BW<sub>−3 dB</sub></b>: f<sub>peak</sub> 주변에서 최대값 대비 −3 dB 이내로 이어진 주파수 폭. 값의 분해능은 STFT bin 간격에 따릅니다.</li>
      <li>점선(fs/2)은 녹음 샘플레이트의 나이퀴스트 주파수이며, 그 위는 자료가 없는 영역입니다.</li>
      <li>출처: Watkins Marine Mammal Sound Database, Woods Hole Oceanographic Institution (Sayigh et al. 2016, <i>Proc. Meet. Acoust.</i> 27, 040013). Hugging Face 공개본 <code>ivangtorre/watkins-marine-mammal-full-cuts</code>에서 받았습니다. 계산 코드: <code>scripts/hero/build_hero.py</code></li>
    </ul>
  </details>
</div>

<script>
  type Clip = {
    record: string; name_ko: string; signal: string; fs: number;
    seg_start: number; seg_end: number; t0: number; t1: number;
    fmin: number; fmax: number; duration: number; f50: number; fpeak: number; bw3: number;
  };
  type Hero = {
    f_min: number; f_max: number; cols_per_sec: number; loop_sec: number;
    pad: number; strip: string; clips: Clip[];
  };

  const SPEED = 120; // CSS px per second (화면 이동 속도)
  const MARK = '#e8a62a';

  const hz = (f: number) => (f >= 1000 ? `${(f / 1000).toFixed(f >= 10000 ? 1 : 2)} kHz` : `${Math.round(f)} Hz`);

  function init(root: HTMLElement) {
    const cfg = JSON.parse(root.querySelector('[data-hero]')!.textContent!) as Hero;
    const spec = root.querySelector<HTMLCanvasElement>('[data-layer=spec]')!;
    const ann = root.querySelector<HTMLCanvasElement>('[data-layer=ann]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const sctx = spec.getContext('2d')!;
    const actx = ann.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const L0 = Math.log(cfg.f_min), LR = Math.log(cfg.f_max) - L0;
    let cssW = 0, cssH = 0, dpr = 1;
    const yOf = (f: number) => (cfg.pad + (1 - cfg.pad) * (1 - (Math.log(f) - L0) / LR)) * cssH;
    const loopW = cfg.loop_sec * SPEED; // CSS px

    // 처음 화면: 큰돌고래 휘슬이 막 지나간 시점
    let T = (cfg.clips[1]?.seg_end ?? 2) + 0.25; // 오른쪽 가장자리의 시각(s)
    let raf = 0, last = 0, visible = true, paused = reduce.matches;
    let strip: HTMLImageElement | null = null;
    let scaled: HTMLCanvasElement | null = null;

    function prepare() {
      if (!strip) return;
      scaled = document.createElement('canvas');
      scaled.width = Math.round(loopW * dpr);
      scaled.height = Math.round(cssH * (1 - cfg.pad) * dpr);
      const c = scaled.getContext('2d')!;
      c.imageSmoothingQuality = 'high';
      c.drawImage(strip, 0, 0, scaled.width, scaled.height);
    }

    function resize() {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      cssW = root.clientWidth; cssH = root.clientHeight;
      for (const c of [spec, ann]) { c.width = Math.round(cssW * dpr); c.height = Math.round(cssH * dpr); }
      prepare();
      draw();
    }

    // 화면 x(CSS px) ↔ 띠 시간(s): 오른쪽 끝 = T
    const xOf = (tLoop: number, k: number) => cssW - (T - (tLoop + k * cfg.loop_sec)) * SPEED;

    function draw() {
      sctx.setTransform(1, 0, 0, 1, 0, 0);
      sctx.fillStyle = '#15181a';
      sctx.fillRect(0, 0, spec.width, spec.height);
      if (scaled) {
        const top = Math.round(cssH * cfg.pad * dpr);
        const k0 = Math.floor((T - cssW / SPEED) / cfg.loop_sec);
        for (let k = k0; k <= k0 + 2; k++) {
          const x = xOf(0, k) * dpr;
          if (x > spec.width || x + scaled.width < 0) continue;
          sctx.drawImage(scaled, Math.round(x), top);
        }
      }
      drawAnnotations();
    }

    function drawAnnotations() {
      actx.setTransform(dpr, 0, 0, dpr, 0, 0);
      actx.clearRect(0, 0, cssW, cssH);
      const k0 = Math.floor((T - cssW / SPEED) / cfg.loop_sec);
      const f1 = '600 12px "IBM Plex Sans KR", system-ui, sans-serif';
      const f2 = '400 11px "IBM Plex Sans KR", system-ui, sans-serif';
      for (let k = k0; k <= k0 + 2; k++) {
        for (const c of cfg.clips) {
          const sx0 = xOf(c.seg_start, k), sx1 = xOf(c.seg_end, k);
          if (sx1 < 0 || sx0 > cssW) continue;

          // 나이퀴스트 주파수 (fs/2)
          const nyq = c.fs / 2;
          if (nyq < cfg.f_max) {
            const y = Math.round(yOf(nyq)) + 0.5;
            actx.globalAlpha = 1;
            actx.strokeStyle = '#5d666c';
            actx.setLineDash([3, 3]);
            actx.lineWidth = 1;
            actx.beginPath(); actx.moveTo(sx0, y); actx.lineTo(sx1, y); actx.stroke();
            actx.setLineDash([]);
            actx.font = f2; actx.fillStyle = '#7d868c'; actx.textBaseline = 'bottom';
            const tl = `fs/2 ${hz(nyq)}`;
            const tx = Math.min(sx1, cssW) - actx.measureText(tl).width - 6;
            if (tx > sx0 + 2 && tx > 110) actx.fillText(tl, tx, y - 3);
          }

          // 신호가 화면 안으로 다 들어오면 주석 표시
          const x0 = xOf(c.t0, k) - 3, x1 = xOf(c.t1, k) + 3;
          const shown = cssW - 6 - x1;
          if (shown < 0 || x1 < 0) continue;
          const alpha = Math.min(1, shown / (SPEED * 0.35));
          const y0 = Math.round(yOf(c.fmax)) - 3, y1 = Math.round(yOf(c.fmin)) + 3;
          actx.globalAlpha = alpha;
          actx.strokeStyle = MARK; actx.lineWidth = 1.5;
          actx.strokeRect(Math.round(x0) + 0.5, y0 + 0.5, Math.round(x1 - x0), y1 - y0);

          const l1 = `${c.name_ko} ${c.signal}`;
          const l2 = `dur90 ${c.duration.toFixed(2)} s   f50 ${hz(c.f50)}   fpeak ${hz(c.fpeak)}   BW−3dB ${hz(c.bw3)}`;
          actx.font = f1; const w1 = actx.measureText(l1).width;
          actx.font = f2; const w2 = actx.measureText(l2).width;
          const lw = Math.ceil(Math.max(w1, w2)) + 12, lh = 33;
          let lx = Math.round(x0);
          lx = Math.max(4, Math.min(lx, cssW - lw - 4));
          let ly = y0 - lh;
          if (ly < 2) ly = y1 + 2;
          actx.fillStyle = MARK;
          actx.fillRect(lx, ly, lw, lh);
          actx.fillStyle = '#15181a'; actx.textBaseline = 'alphabetic';
          actx.font = f1; actx.fillText(l1, lx + 6, ly + 14);
          actx.font = f2; actx.fillText(l2, lx + 6, ly + 28);
        }
      }
      actx.globalAlpha = 1;
    }

    function step(now: number) {
      raf = 0;
      if (paused || !visible) return;
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      T += dt;
      if (T > 1e5) T -= Math.floor(T / cfg.loop_sec) * cfg.loop_sec;
      draw();
      raf = requestAnimationFrame(step);
    }

    function play() {
      if (!raf && !paused && visible) { last = 0; raf = requestAnimationFrame(step); }
    }
    function setPaused(p: boolean) {
      paused = p;
      btn.textContent = p ? '재생' : '일시정지';
      btn.setAttribute('aria-pressed', String(p));
      if (!p) play();
    }

    btn.addEventListener('click', () => setPaused(!paused));
    reduce.addEventListener?.('change', () => setPaused(reduce.matches));
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; play(); }).observe(root);
    document.addEventListener('visibilitychange', () => { visible = !document.hidden; play(); });
    let rt = 0;
    new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(resize, 120); }).observe(root);

    const img = new Image();
    img.decoding = 'async';
    img.onload = () => { strip = img; prepare(); draw(); };
    img.src = cfg.strip;

    resize();
    setPaused(paused);
    document.fonts?.ready.then(() => draw());
  }

  document.querySelectorAll<HTMLElement>('[data-spectrogram]').forEach(init);
</script>
